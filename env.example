# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app.com

# Thirdweb
THIRDWEB_SECRET_KEY=
THIRDWEB_PROJECT_WALLET=
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# for verifying SIWE signatures
ADMIN_PRIVATE_KEY=

# Neynar (Farcaster)
NEYNAR_API_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube API (for live stream banner)
YOUTUBE_API_KEY=

# SerpAPI (for price comparison feature)
# Get your API key at https://serpapi.com/
# Free tier: 100 searches/month
# Starter plan: $50/month for 5,000 searches ($0.01 per search)
SERPAPI_KEY=

# Ponder (blockchain indexer)
# Comma-separated list of RPC URLs for Base mainnet
# Ponder will use these as fallbacks if one fails
# Example: PONDER_RPC_URLS=https://base-mainnet.infura.io/v3/YOUR_KEY,https://api.developer.coinbase.com/rpc/v1/base/YOUR_KEY,https://mainnet.base.org
PONDER_RPC_URLS=